# Ignore source files (TS) — bundled into out/index.js by esbuild
src/

# Ignore esbuild's own build script — dev tooling, not runtime
esbuild.js

# out/ holds tsc's unbundled emit, kept only so `npm test` has something to
# run against. The packaged extension needs none of it except the esbuild
# bundle and its map. Exclude everything under out/, then re-include just
# those two: out/** matches paths inside out/ (never the out/ entry itself),
# so vsce still descends into it and honours the negated lines below.
out/**
!out/index.js
!out/index.js.map

# Dependencies are bundled into out/index.js by esbuild — none of the
# dependency tree needs to ship.
node_modules/

# Ignore unneeded VS Code metadata
.vscode/
.vscode-test/
.vscode-test-web/

# Ignore dev junk
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.eslintcache
.stylelintcache

# Ignore OS junk
.DS_Store

# Do NOT ignore:
# - out/index.js
# - out/index.js.map
# - package.json
# - README.md
# - LICENSE
# - icon.png / banner.png
