{
  "name": "markdown-exporter",
  "displayName": "Selection Markdown Exporter",
  "description": "Export selected files and folders to a single markdown file, perfect for AI analysis and documentation generation.",
  "version": "1.0.9",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/index.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownExport.copy",
        "title": "Copy as Markdown",
        "category": "Markdown Export"
      },
      {
        "command": "markdownExport.export",
        "title": "Export to Markdown",
        "category": "Markdown Export"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "markdownExport.copy",
          "group": "markdownExport@1",
          "when": "true"
        },
        {
          "command": "markdownExport.export",
          "group": "markdownExport@2",
          "when": "true"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownExport.copy",
          "when": "true"
        },
        {
          "command": "markdownExport.export",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Export",
      "properties": {
        "markdownExport.outputFile": {
          "type": "string",
          "default": "FULL_CODE.md",
          "description": "Output file name (relative to workspace root)",
          "scope": "resource"
        },
        "markdownExport.additionalIgnore": {
          "type": "array",
          "default": [],
          "description": "Additional paths to ignore (relative to workspace root)",
          "items": {
            "type": "string",
            "description": "Path to ignore"
          },
          "scope": "resource"
        },
        "markdownExport.binaryFileExtensions": {
          "type": "array",
          "default": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "bmp",
            "webp",
            "tif",
            "tiff",
            "ico",
            "avif",
            "heic",
            "heif",
            "mp4",
            "mov",
            "avi",
            "mkv",
            "webm",
            "mpeg",
            "mpg",
            "3gp",
            "ogv",
            "pdf",
            "doc",
            "docx",
            "xls",
            "xlsx",
            "ppt",
            "pptx",
            "zip",
            "rar",
            "7z",
            "gz",
            "tar",
            "exe",
            "dll",
            "so",
            "dylib"
          ],
          "description": "Binary file extensions (without dots) to exclude from content embedding",
          "items": {
            "type": "string",
            "description": "File extension (without dot)"
          },
          "scope": "resource"
        },
        "markdownExport.maxFileSizeBytes": {
          "type": "number",
          "default": 1048576,
          "description": "Files larger than this many bytes become stubs: listed in the export at their path, with their content omitted and the reason stated. Zero means no limit.",
          "scope": "resource"
        },
        "markdownExport.binaryFiles": {
          "type": "array",
          "default": [],
          "description": "Exact file paths to treat as binary (relative to workspace root)",
          "items": {
            "type": "string",
            "description": "Exact file path to ignore"
          },
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts --max-warnings 0",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/vsce": "^3.7.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "ignore": "^5.2.4"
  },
  "banner": "banner.png",
  "publisher": "joaodavidsilva",
  "keywords": [
    "markdown",
    "export",
    "documentation",
    "ai",
    "codebase"
  ]
}
