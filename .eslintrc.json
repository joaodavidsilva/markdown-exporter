{
  "root": true,
  "env": {
    "node": true,
    "es2020": true
  },
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    // Type-aware rules need the program. Every linted file lives under src,
    // which this tsconfig covers.
    "project": "./tsconfig.json"
  },
  "rules": {
    "no-console": "off",

    // Correctness. The v2.0 core becomes an asynchronous streaming pipeline,
    // so a dropped promise is the defect class most worth catching early.
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/no-misused-promises": "error",
    "@typescript-eslint/await-thenable": "error",
    "no-throw-literal": "off",
    "@typescript-eslint/no-throw-literal": "error",
    "no-return-await": "off",
    "@typescript-eslint/return-await": ["error", "in-try-catch"],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-implicit-coercion": "error",

    // Dead code. Caught errors count too: a binding that is never read hides
    // the reason an export failed. Prefix with _ to say the miss is deliberate.
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrors": "all",
      "caughtErrorsIgnorePattern": "^_"
    }],

    // Consistency.
    "curly": ["error", "all"],
    "no-var": "error",
    "prefer-const": "error",
    "@typescript-eslint/consistent-type-definitions": ["error", "interface"]
  },
  "overrides": [
    {
      // ADR-0001: the core is independent of the VS Code API, so that the
      // suite can exercise it over real temporary directories in seconds
      // without launching an editor. A single import here would make the
      // whole thing unrunnable, and the failure would look like a tooling
      // problem rather than a design one. The tests live under the same rule
      // because a test that needs the editor defeats the same purpose.
      "files": ["src/core/**/*.ts", "src/test/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{
            "name": "vscode",
            "message": "ADR-0001: nothing beneath the expandSelection / createExport seams may import the VS Code API. Read configuration at the adapter boundary and pass it in as a plain value."
          }],
          "patterns": [{
            "group": ["**/adapter/**", "**/config/**"],
            "message": "ADR-0001: the adapter depends on the core, never the other way round. This is how the editor API reached the walker's innermost loop before: the core imported the settings module, and the settings module imports vscode."
          }]
        }]
      }
    },
    {
      "files": ["src/test/**/*.ts"],
      "rules": {
        // node:test's top-level test() returns a promise the runner owns, so
        // every test case would report as a floating promise. The option that
        // states this precisely, allowForKnownSafeCalls, needs
        // typescript-eslint v8; this project is on v6 for ESLint 8. Every
        // other rule still applies to the test sources.
        "@typescript-eslint/no-floating-promises": "off"
      }
    }
  ]
}
